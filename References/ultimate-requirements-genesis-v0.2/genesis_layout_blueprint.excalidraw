    },
    {
      "id": "5d6b94fe",
      "type": "text",
      "x": 120,
      "y": 1070,
      "width": 410,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
