    },
    {
      "id": "886b2192",
      "type": "text",
      "x": 120,
      "y": 450,
      "width": 410,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
